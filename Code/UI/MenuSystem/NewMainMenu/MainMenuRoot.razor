@using Sandbox.Menu
@using Sandbox.UI;
@using Sandbox.Network;

@inherits Sandbox.UI.NavHostPanel
@namespace KOTH.UI

<root>
	@*<div class="background" />

	<div class="navigator-canvas" slot="navigator-canvas" />*@
</root>

@code
{
	public MainMenuRoot()
	{
		DefaultUrl = "/";
		AddDestination("/", typeof(BaseMenu));
		AddDestination("/singleplayer", typeof(SinglePlayer));
		AddDestination("/multiplayer", typeof(MultiPlayer));
		AddDestination("/about", typeof(About));
	}

	private async void Join()
	{
		var Lobbies = await Networking.QueryLobbies(Game.Ident);
		if (Lobbies.Any())
		{
			var Lobby = Lobbies.First();
			if (await Networking.TryConnectSteamId(Lobby.LobbyId))
			{
				Log.Info("joined lobby!");
			}
			return; // NOTE : early return!
		}

		var sc = ResourceLibrary.Get<SceneFile>("prefabs/scenes/product/koth_product.scene");
		Game.ActiveScene.Load(sc);
	}
}