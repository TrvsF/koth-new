@namespace KOTH.UI
@using KOTH.Notification
@using Sandbox.Events
@inherits PanelComponent

@if (!IsHudEnabled)
	return;

@if (!PlayerState.Local.PlayerPawn.IsValid())
	return;

<root>
	<canvas>
		<Watermark />
		<DamageNumbers />
		<Toast />
		<DamageIndicatorNew />
		<StickyOverlay />
		<HealStatus />
		<SmallClassSelect />
		<XHair />
		<Health />
		<Ammo />

		<RoundStateDisplay />


		@if (notification != null && notification.Zone == NotificationZone.TopCenter)
		{
			<div class="top-middle" style="color: @notification.Color; @notification.Css">
				<strong>
					@notification.Message
				</strong>
			</div>
		}
		@if (notification != null && notification.Zone == NotificationZone.Center)
		{
			<div class="middle" style="color: @notification.Color; @notification.Css">
				<strong>
					@notification.Message
				</strong>
			</div>
		}
		@if (notification != null && notification.Zone == NotificationZone.LowerCenter)
		{
			<div class="bottom-middle" style="color: @notification.Color; @notification.Css">
				<strong>
					@notification.Message
				</strong>
			</div>
		}

		<div class="right">
			<div class="flex-grow" />
			<Voices />
			<WeaponInfoComponent />
		</div>

		<Radio />

		<ScoringSystem @ref="ScoringSystem" />
	</canvas>

	<Scoreboard />

	<div class="hud flex column justify-start bottom-left chat">
		@foreach (var VisableMessage in TextChat.Instance.GetVisableMessages())
		{
			@if (VisableMessage.AuthorSteamID > 0)
			{
				<div class="square rounded shrink-0" style="background-image: url( avatar:@VisableMessage.AuthorSteamID )"></div>
			}
			<label class="message no-shadow">@VisableMessage.GetChatMessage()</label>
		}
		<TextChatBox @ref="TextChat.Instance.InputBox" onsubmit="@TextChat.Instance.InputBox.SendMessage"></TextChatBox>
	</div>
</root>

@code
{
	public Notification notification { get; set; }

	[ConVar("cl_drawhud")]
	public static bool IsHudEnabled { get; set; } = true;

	[DeveloperCommand("Toggle HUD", "Visuals")]
	private static void Command_ToggleHUD()
	{
		IsHudEnabled = !IsHudEnabled;
	}

	public ScoringSystem ScoringSystem { get; set; }

	protected override void OnEnabled()
	{
		base.OnEnabled();

		TextChat.Instance.InputBox = new();
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();

		if (!PlayerState.Local.IsValid() || !PlayerState.Local.PlayerPawn.IsValid())
		{
			return;
		}

		notification = NotificationManager.Instance.GetNotification();

		if (Input.Pressed("chat"))
		{
			NotificationManager.Instance.AddNotification(new Notification("Test 1", 30, NotificationZone.TopCenter));
			TextChat.Instance?.InputBox?.Focus();
		}
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(Time.Now);
	}
}