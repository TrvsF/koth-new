@namespace KOTH.UI
@inherits Panel
@attribute [StyleSheet]

@if (!Player.IsValid() || !Player.IsAlive)
	return;

<root class="flex row gap align-center justify-end" style="width: 100px;">
	@if (IsHealing())
	{
		<label class="healing" style="color: @GetHealInfo().GetColour().Hex;">@GetHealInfo().Name | @GetHealInfo().Health</label>
	}

	@if (IsBeingHealed())
	{
		<label class="healed">@GetHealInfo().Name | <div style="color: @GetHealInfo().GetColour().Hex;">@GetHealInfo().Health</div></label>
	}
</root>

@code
{
	public PlayerPawn Player => PlayerState.Local?.PlayerPawn;
	private HealBeamComponent HealBeamComponent => Player.CurrentEquipment.IsValid() ? Player?.CurrentEquipment.Components.Get<HealBeamComponent>(FindMode.EverythingInSelfAndDescendants) : null;

	struct FHealTarget
	{
		public FHealTarget() { }

		public string Name { get; init; } = "";
		public string Health { get; init; } = "";
		public string MaxHealth { get; init; } = "";
		public string Ammo { get; init; } = "";

		public Color GetColour()
		{
			return Health.ToInt() > MaxHealth.ToInt() ? Color.Green : Color.White;
		}
	}

	private bool IsHealing()
	{
		return HealBeamComponent.IsValid() ? HealBeamComponent.HealTarget.IsValid() : false;
	}

	private FHealTarget GetHealInfo()
	{
		var Target = HealBeamComponent?.HealTarget;
		if (!Target.IsValid())
			return new();

		return new()
			{
				Name = Target.DisplayName,
				Health = Target.Health.ToString(),
				MaxHealth = Target.MaxHealth.ToString(),
			};
	}

	private bool IsBeingHealed()
	{
		return false;
	}

	protected override int BuildHash()
	{
		if (!Player.IsValid() || !Player.CurrentEquipment.IsValid())
			return 0;

		return HashCode.Combine(Time.Now);
	}
}
