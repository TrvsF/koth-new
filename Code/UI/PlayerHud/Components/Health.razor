@namespace KOTH.UI
@inherits Panel
@attribute [StyleSheet]

@if ( !Player.IsValid() )
    return;

@if ( !Player.CurrentEquipment.IsValid() )
    return;

<root>
    <label class="hp" style="color: @(Color.Lerp(Color.Red, Color.White, Player.Health / Player.MaxHealth).Hex);">@(Player.DamageComponent.GetHealthString() ?? "∞")</label>
</root>

@code
{
    public PlayerPawn Player => PlayerState.Local.PlayerPawn;

    protected override int BuildHash()
    {
        if (!Player.IsValid())
            return 0;
        return HashCode.Combine(Time.Now);
    }
}
