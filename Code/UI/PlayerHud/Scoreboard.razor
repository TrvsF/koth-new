@using System;
@using Sandbox.UI;

@namespace KOTH.UI
@inherits Panel

@attribute [StyleSheet]

<root class="hidden flex absolute inset-0 align-center justify-center">
@* 	<div class="title">
		@GameMode.Instance.Title
	</div> *@
	<table class="with-padding-lg layout" style="background-color: rgba( red, 0.33 );">
		<div class="row header with-px-lg with-py-sm">
			<label class="col stat stat-large">Team A</label>
			<label class="col stat stat-large">Frags</label>
			<label class="col stat stat-large">Deaths</label>
			<label class="col stat stat-large">Points</label>
		</div>

		<div class="row header with-px-lg with-py-sm">
			<label class="col stat stat-large">travis</label>
			<label class="col stat stat-large">1337</label>
			<label class="col stat stat-large">1337</label>
			<label class="col stat stat-large">1337</label>
		</div>
		<div class="row header with-px-lg with-py-sm">
			<label class="col stat stat-large">travis</label>
			<label class="col stat stat-large">1337</label>
			<label class="col stat stat-large">1337</label>
			<label class="col stat stat-large">1337</label>
		</div>
		<div class="row header with-px-lg with-py-sm">
			<label class="col stat stat-large">travis</label>
			<label class="col stat stat-large">1337</label>
			<label class="col stat stat-large">1337</label>
			<label class="col stat stat-large">1337</label>
		</div>
	</table>
	<table class="with-padding-lg layout" style="background-color: rgba( green, 0.33 );">
		<div class="row header with-px-lg with-py-sm">
			<label class="col stat stat-large">Team B</label>
			<label class="col stat stat-large">Frags</label>
			<label class="col stat stat-large">Deaths</label>
			<label class="col stat stat-large">Points</label>
		</div>
		@(GeneratePlayerRow(PlayerState.Local))
	</table>
</root>

@code
{
	private RenderFragment GeneratePlayerRow(PlayerState PlayerState) => Builder =>
	{
		Builder.OpenElement(0, "div");
		Builder.AddAttribute(1, "class", "row header with-px-lg with-py-sm");

		Builder.OpenElement(2, "label");
		Builder.AddAttribute(3, "class", "col stat stat-large");
		Builder.AddContent(4, PlayerState.SteamName);
		Builder.CloseElement();

		Builder.OpenElement(5, "label");
		Builder.AddAttribute(6, "class", "col stat stat-large");
		Builder.AddContent(7, 0);
		Builder.CloseElement();

		Builder.OpenElement(8, "label");
		Builder.AddAttribute(9, "class", "col stat stat-large");
		Builder.AddContent(10, 0);
		Builder.CloseElement();

		Builder.OpenElement(11, "label");
		Builder.AddAttribute(12, "class", "col stat stat-large");
		Builder.AddContent(13, 0);
		Builder.CloseElement();

		Builder.CloseElement();
	};

	public bool IsActive { get; set; }

	protected override int BuildHash()
	{
		return HashCode.Combine(Time.Now);
	}

	public override void Tick()
	{
		if (Input.Pressed("Score"))
		{
			IsActive = Input.Pressed("Score");
			SetClass("visible", true);
		}

		if (Input.Released("Score"))
		{
			SetClass("visible", false);
			IsActive = false;
		}
	}
}
