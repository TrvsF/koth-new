@using System;
@using Sandbox.UI;

@namespace KOTH.UI
@inherits Panel

@attribute [StyleSheet]

<root class="hidden flex absolute inset-0 align-center justify-center">
@* 	<div class="title">
		@GameMode.Instance.Title
	</div> *@
	<table class="with-padding-lg layout" style="background-color: rgba( red, 0.33 );">
		<div class="row header with-px-lg with-py-sm">
			<label class="col stat-avatar"></label>
			<label class="col stat-large">Team A</label>
			<label class="col stat">Points</label>
			<label class="col stat">Frags</label>
			<label class="col stat">Deaths</label>
		</div>

		<div class="row header with-px-lg with-py-sm" onclick="@(() => Log.Info("clicky"))">

			<label class="col stat-avatar" style="background-image: url(avatar:@PlayerState.Local.SteamId);"></label>
			<label class="col stat-large">travis</label>

			<label class="col stat">1337</label>
			<label class="col stat">9</label>
			<label class="col stat">5</label>
		</div>

		@GeneratePlayerRow(PlayerState.Local)
		@GeneratePlayerRow(PlayerState.Local)
		@GeneratePlayerRow(PlayerState.Local)
	</table>
	<table class="with-padding-lg layout" style="background-color: rgba( green, 0.33 );">
		<div class="row header with-px-lg with-py-sm">
			<label class="col stat-avatar"></label>
			<label class="col stat-large">Team A</label>
			<label class="col stat">Points</label>
			<label class="col stat">Frags</label>
			<label class="col stat">Deaths</label>
		</div>

		@GeneratePlayerRow(PlayerState.Local)
		@GeneratePlayerRow(PlayerState.Local)
		@GeneratePlayerRow(PlayerState.Local)
	</table>
</root>

@code
{
	private RenderFragment GeneratePlayerRow(PlayerState playerState) => builder =>
	{
	builder.OpenElement(0, "div");
	builder.AddAttribute(1, "class", "row header with-px-lg with-py-sm");
	// builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => Log.Info("clicky")));

	// Avatar Column
	builder.OpenElement(3, "label");
	builder.AddAttribute(4, "class", "col stat-avatar");
	builder.AddAttribute(5, "style", $"background-image: url(avatar:{playerState.SteamId});");
	builder.CloseElement();

	// Player Name Column
	builder.OpenElement(6, "label");
	builder.AddAttribute(7, "class", "col stat-large");
	builder.AddContent(8, playerState.SteamName);
	builder.CloseElement();

	// Stat Columns
	builder.OpenElement(9, "label");
	builder.AddAttribute(10, "class", "col stat");
	builder.AddContent(11, 1337); // Replace with actual stat property
	builder.CloseElement();

	builder.OpenElement(12, "label");
	builder.AddAttribute(13, "class", "col stat");
	builder.AddContent(14, 20); // Replace with actual stat property
	builder.CloseElement();

	builder.OpenElement(15, "label");
	builder.AddAttribute(16, "class", "col stat");
	builder.AddContent(17, 4); // Replace with actual stat property
	builder.CloseElement();

	builder.CloseElement(); // Close the row div
	};

	public bool IsActive { get; set; }

	protected override int BuildHash()
	{
		return HashCode.Combine(Time.Now);
	}

	public override void Tick()
	{
		if (Input.Pressed("Score"))
		{
			IsActive = Input.Pressed("Score");
			SetClass("visible", true);
		}

		if (Input.Released("Score"))
		{
			SetClass("visible", false);
			IsActive = false;
		}
	}
}
