@namespace KOTH.UI
@inherits Panel
@attribute [StyleSheet]

<root>
	@foreach (var DamageNumberElement in DamageNumberElements)
	{
		<label class="damage-number" style="font-size: @(DamageNumberElement.GetSizePx())px; color: @(DamageNumberElement.GetColour().Hex); left: @(DamageNumberElement.GetScreenPos().x * 100)%; top: @(DamageNumberElement.GetScreenPos().y * 100)%; ">
			@(DamageNumberElement)
		</label>
	}
</root>

@code
{
	// TODO : put these in a helper somewhere

	public Vector2 GetScreenPosFromPosition(Vector3 Position, out bool IsBehind)
	{
		return LocalPlayerPawn.Camera.PointToScreenNormal(Position, out IsBehind);
	}

	public Vector2 GetScreenOffset(float Distance = 0f)
	{
		float DistanceFactor = 0.01f; //0.007f * (float)Math.Sqrt(Distance);

		float XOffset = (float)(Random.Shared.NextDouble() * DistanceFactor * 2) - DistanceFactor;
		float YOffset = (float)(Random.Shared.NextDouble() * (0.15f - DistanceFactor)) + DistanceFactor;
		return new Vector2(XOffset, -YOffset);
	}

	////////////////////////////////////////////////////////////////////////////////////////

	public static DamageNumbers Instance { get; set; }

	public DamageNumbers()
	{
		Instance = this;
	}

	List<FScreenNumberElement> DamageNumberElements = new();
	PlayerPawn LocalPlayerPawn => PlayerState.Local.IsValid() ? PlayerState.Local.PlayerPawn : null;

	public void OnHit(FDamageTaken DamageGiven)
	{
		if (!LocalPlayerPawn.IsValid() || !LocalPlayerPawn.IsAlive || DamageGiven.VictimPlayerPawn == LocalPlayerPawn)
		{
			return;
		}

		var Distance = DamageGiven.DamageLocation.Distance(LocalPlayerPawn.WorldPosition);
		var DamageLocation = DamageGiven.DamageType == EDamageType.Projectile && DamageGiven.VictimGameObject.IsValid() ? DamageGiven.VictimGameObject.WorldPosition : DamageGiven.DamageLocation;

		foreach (var Element in DamageNumberElements)
		{
			if (Element.TargetPawn == DamageGiven.VictimPlayerPawn)
			{
				Element.AddDamage(DamageGiven.Damage);
				Element.DisplayedTime = 0;
				Element.Location = DamageLocation;

				return; // NOTE : early return
			}
		}

		// if we haven't return'd then make a new element
		FScreenNumberElement DamageNumberElement = new()
			{
				PlayerPawn = LocalPlayerPawn,
				TargetPawn = DamageGiven.VictimPlayerPawn,
				ScreenOffset = GetScreenOffset(Distance),
				Damage = DamageGiven.Damage,
				DisplayedTime = 0,
				Location = DamageLocation,
			};

		DamageNumberElements.Add(DamageNumberElement);
	}

	public override void Tick()
	{
		List<FScreenNumberElement> DamageNumbersToRemove = new();

		foreach (var DamageNumber in DamageNumberElements)
		{
			if (DamageNumber.DisplayedTime < -0.3f)
			{
				DamageNumbersToRemove.Add(DamageNumber);
			}
		}

		foreach (var Remove in DamageNumbersToRemove)
		{
			DamageNumberElements.Remove(Remove);
		}
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(Time.Now);
	}
}
