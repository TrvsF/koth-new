	public Vector2 GetScreenPosFromPosition(Vector3 Position, out bool IsBehind)
	{
		return LocalPlayerPawn.Camera.PointToScreenNormal(Position, out IsBehind);
	}

	public Vector2 GetScreenOffset(float Distance = 0f)
	{
		float DistanceFactor = 0.01f; //0.007f * (float)Math.Sqrt(Distance);

		float XOffset = (float)(Random.Shared.NextDouble() * DistanceFactor * 2) - DistanceFactor;
		float YOffset = (float)(Random.Shared.NextDouble() * (0.15f - DistanceFactor)) + DistanceFactor;
		return new Vector2(XOffset, -YOffset);
	}

