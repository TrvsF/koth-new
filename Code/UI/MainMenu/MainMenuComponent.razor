	<canvas>
		<Watermark />

		@* <div class="nav">
			@if (BaseMenu)
			{
				<button onclick=@(() => { BaseMenu = false; SinglePlayer = true; })>SinglePlayer</button>
				<button onclick=@(() => { BaseMenu = false; Multiplayer = true; })>Multiplayer</button>
				<button onclick=@(() => Game.Overlay.ShowSettingsModal())>Settings</button>
