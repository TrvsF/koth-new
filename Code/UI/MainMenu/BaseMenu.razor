@using Sandbox.Menu
@using Sandbox.UI;
@using Sandbox.Network;

@inherits Panel
@namespace KOTH.UI

<root>
	<div class="mm-options">
		<button class="mm-option" onclick=@(() => JoinBotz())>botz</button>
		<button class="mm-option" onclick=@(() => JoinSingleplayer())>jumpmap</button>
		<button class="mm-option" onclick=@(() => JoinBestLobby())>quickplay</button>
		<button class="mm-option" onclick=@(() => JoinBestLobby())></button>
		@*<a class="mm-option" href="/about">about</a>*@
		<button class="mm-option" onclick=@(() => Game.Close())>quit</button>
	</div>
</root>

@code
{
	public bool IsHidden = false;
	public static BaseMenu Instance;

	public BaseMenu()
	{
		Instance = this;
	}

	private async void JoinMultiplayerlayer()
	{
		var Lobbies = await Networking.QueryLobbies(Game.Ident);
		if (Lobbies.Any())
		{
			var Lobby = Lobbies.First();
			if (await Networking.TryConnectSteamId(Lobby.LobbyId))
			{
				Log.Info("joined lobby!");
			}
			return; // NOTE : early return!
		}

		var sc = ResourceLibrary.Get<SceneFile>("prefabs/scenes/product/koth_product.scene");
		Game.ActiveScene.Load(sc);
	}

	private async void JoinBotz()
	{
		var sc = ResourceLibrary.Get<SceneFile>("prefabs/scenes/botz/botz.scene");
		Game.ActiveScene.Load(sc);
	}

	private async void JoinSingleplayer()
	{
		var sc = ResourceLibrary.Get<SceneFile>("prefabs/scenes/jump1/jump1.scene");
		Game.ActiveScene.Load(sc);
	}

	private async void JoinBestLobby()
	{
		var Lobbies = await Networking.QueryLobbies(Game.Ident);
		var LobbiesCount = Lobbies.Count;

		if (LobbiesCount == 0)
		{
			Log.Info($"no servers found");
			var FallbackMap = ResourceLibrary.Get<SceneFile>("prefabs/scenes/product/koth_product.scene");
			Game.ActiveScene.Load(FallbackMap);
			return;
		}

		// try join random lobby
		var RandomLobbyIndex = Random.Shared.Next(LobbiesCount);
		var RandomLobbyId = Lobbies[RandomLobbyIndex].LobbyId;
		if (await Networking.TryConnectSteamId(RandomLobbyId))
		{
			// conencted
			return; // NOTE : early return!
		}

		// else just try & join any leftovers
		foreach (var Lobby in Lobbies)
		{
			if (Lobby.LobbyId == RandomLobbyId || Lobby.IsFull)
			{
				continue;
			}

			if (await Networking.TryConnectSteamId(RandomLobbyId))
			{
				// conencted
				return; // NOTE : early return!
			}
		}
	}
}